server {

	server_name armontex.ai-info.ru;


	root /var/www/boardy;

	index index.html;


	access_log /var/log/nginx/boardy-access.log;

	error_log /var/log/nginx/boardy-error.log;


	location / {

		try_files $uri $uri/ =404;

	}


	error_page 404 /404.html;

	listen 443 ssl;

	add_header Strict-Transport-Security "max-age=31536000" always;

	ssl_certificate /etc/letsencrypt/live/armontex.ai-info.ru/fullchain.pem;

	ssl_certificate_key /etc/letsencrypt/live/armontex.ai-info.ru/privkey.pem;

	include /etc/letsencrypt/options-ssl-nginx.conf;

	ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

	location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg)$ {

		expires 7d;

		add_header Cache-Control "public, no-transform";

	}

}
server {
	if ($host = armontex.ai-info.ru) {
		return 301 https://$host$request_uri;
	} # managed by Certbot



	listen 80;

	server_name armontex.ai-info.ru;
	return 404; # managed by Certbot


}
